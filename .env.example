# Copy this file to .env and fill in real values. Never commit .env.
# docker compose reads .env automatically.

# --- Used by docker compose (Postgres container + the app inside Compose) ---
POSTGRES_DB=linkly
POSTGRES_USER=linkly
POSTGRES_PASSWORD=change-me
# Host port for the app (change it if 8080 is already in use)
APP_PORT=8080

# --- Used when running the app outside Docker (./mvnw spring-boot:run) ---
DB_URL=jdbc:postgresql://localhost:5432/linkly
DB_USER=linkly
DB_PASSWORD=change-me
VALKEY_HOST=localhost
VALKEY_PORT=6379

# Public base of the short URLs (e.g. https://linkly.app in production)
LINKLY_BASE_URL=http://localhost:8080

# Secret for POST /api/keys (header X-Admin-Token). Use a long random value, e.g. `openssl rand -hex 32`.
ADMIN_TOKEN=change-me
# Rate limit per API key (token bucket): burst size, and seconds to get 1 token back
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_SECONDS=6

# Copy this file to .env and fill in real values. Never commit .env.
# docker compose reads .env automatically.

# --- Used by docker compose (Postgres container + the app inside Compose) ---
POSTGRES_DB=linkly
POSTGRES_USER=linkly
POSTGRES_PASSWORD=change-me
# Host port for the app (change it if 8080 is already in use)
APP_PORT=8080

# --- Used when running the app outside Docker (./mvnw spring-boot:run) ---
DB_URL=jdbc:postgresql://localhost:5432/linkly
DB_USER=linkly
DB_PASSWORD=change-me

# Public base of the short URLs (e.g. https://linkly.app in production)
LINKLY_BASE_URL=http://localhost:8080
